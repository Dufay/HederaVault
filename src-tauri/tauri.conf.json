{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HederaVault",
  "version": "0.1.0",
  "identifier": "org.hederavault.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --prefix desktop-ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build --prefix desktop-ui",
    "frontendDist": "../desktop-ui/dist"
  },
  "app": {
    "windows": [
      {
        "title": "HederaVault",
        "width": 960,
        "height": 720,
        "minWidth": 640,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
